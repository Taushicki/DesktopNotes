<Window x:Class="DesktopNotes.Presentation.DeleteConfirmationWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DesktopNotes.Presentation"
        Title="{local:Tr 'Удаление заметки'}" Width="430" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource NoteMenuForeground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ToolbarStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="Surface" Background="{DynamicResource NoteMenuBackground}"
            BorderBrush="{DynamicResource NoteMenuBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
        <StackPanel>
            <TextBlock Text="{local:Tr 'Удалить заметку?'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="{local:Tr 'Заметка и её связи будут удалены без возможности восстановления.'}"
                       TextWrapping="Wrap" Foreground="{DynamicResource NoteMenuMuted}" Margin="0,0,0,20" />
            <Border Height="1" Background="{DynamicResource NoteMenuBorder}" Margin="-20,0,-20,16" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{local:Tr 'Отмена'}" IsCancel="True" IsDefault="True" Click="CancelClicked"
                        Style="{StaticResource ToolbarButton}" Background="{DynamicResource NoteMenuHover}"
                        Foreground="{DynamicResource NoteMenuForeground}" MinWidth="100" Padding="14,9" Margin="0,0,8,0" />
                <Button x:Name="DeleteButton" Content="{local:Tr 'Удалить'}" Click="DeleteClicked"
                        Style="{StaticResource ToolbarButton}" Background="{DynamicResource NoteMenuHover}"
                        Foreground="#E55353" MinWidth="100" Padding="14,9" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
